@model Layout.Models.ViewModels.RegisterViewModel

@{
    Layout = "_LayoutLogin";
    ViewData["Title"] = "Solicitar Acceso";
}

<div class="d-flex justify-content-center align-items-center py-4" style="min-height: 90vh;">

    <div class="card shadow-lg border-0 rounded-4" style="width: 400px;">

        <div class="card-body p-4 text-center">

            <!-- Logo Corporativo Protegido -->
            <div class="bg-white rounded-3 border p-2 mb-3 d-inline-block shadow-sm" style="background-color: #f1f5f9 !important;">
                <img src="/image/toyoda-gosei-logo.png" alt="Toyoda Gosei" class="img-fluid" style="max-height: 34px; object-fit: contain;" />
            </div>

            <!-- Título del Formulario -->
            <h4 class="fw-bold mb-1 text-secondary">
                @ViewData["Title"]
            </h4>

            <p class="text-muted small mb-4">
                Solicitudes de Movimientos de Layout
            </p>

            <form asp-controller="Account" asp-action="Register" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3 text-center border-0 rounded-3"></div>

                <!-- Campo: Nombre Completo -->
                <div class="mb-3 text-start">
                    <label asp-for="NombreCompleto" class="form-label fw-semibold small text-secondary">Nombre Completo</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-person"></i>
                        </span>
                        <input asp-for="NombreCompleto" class="form-control border-start-0 py-2" placeholder="Nombre completo" required />
                    </div>
                    <span asp-validation-for="NombreCompleto" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Campo: Correo Electrónico -->
                <div class="mb-3 text-start">
                    <label asp-for="Email" class="form-label fw-semibold small text-secondary">Correo Electrónico</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input asp-for="Email" type="email" class="form-control border-start-0 py-2" placeholder="correo@toyodagosei.com" required />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Campo: Contraseña -->
                <div class="mb-3 text-start">
                    <label asp-for="Password" class="form-label fw-semibold small text-secondary">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input asp-for="Password" type="password" class="form-control border-start-0 py-2" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Campo: Confirmar Contraseña -->
                <div class="mb-4 text-start">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold small text-secondary">Confirmar Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted">
                            <i class="bi bi-shield-lock"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 py-2" placeholder="••••••••" required />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small mt-1 d-block"></span>
                </div>

                <!-- Alerta Informativa de Aprobación de Acceso -->
                <div class="alert alert-info border-0 small text-start rounded-3 mb-4 p-2.5 bg-info-subtle text-info shadow-xs">
                    <div class="d-flex align-items-start">
                        <i class="bi bi-info-circle-fill fs-5 me-2 mt-0.5"></i>
                        <span style="font-size: 0.8rem; line-height: 1.4;">
                            Un administrador revisará tu información, asignará tus permisos técnicos/operativos y autorizará el acceso.
                        </span>
                    </div>
                </div>

                <!-- Botón de Envío Tipo Píldora -->
                <button type="submit" class="btn btn-success w-100 rounded-pill fw-semibold py-2 shadow-sm">
                    <i class="bi bi-person-plus me-1.5"></i>Solicitar Acceso
                </button>

            </form>

            <hr class="my-4 text-muted opacity-25" />

            <!-- Sección de Regresar -->
            <div class="text-center">
                <a asp-controller="Account" asp-action="Login" class="btn btn-link text-decoration-none fw-bold small p-0 text-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Volver al Inicio de Sesión
                </a>
            </div>

        </div>

        <!-- Pie de la Tarjeta -->
        <div class="card-footer text-muted text-center small py-2.5 bg-light border-top-0">
            &copy; @DateTime.Now.Year - Layout System By IoT
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
