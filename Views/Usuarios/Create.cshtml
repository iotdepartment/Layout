@model Layout.Models.ViewModels.UsuarioCreateViewModel

<div class="card shadow-sm border-0 rounded-3">

    <div class="card-header bg-white border-bottom-0 pt-3">
        <h4 class="fw-bold text-secondary mb-0">Alta de Usuario</h4>
    </div>

    <div class="card-body">

        <!-- CORRECCIÓN: Abrir la etiqueta form correctamente con sus Tag Helpers -->
        <form asp-action="Create" method="post">

            <!-- Resumen de validaciones -->
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NombreCompleto" class="form-label fw-semibold">Nombre Completo</label>
                <input asp-for="NombreCompleto" class="form-control" placeholder="Ej. Juan Pérez" />
                <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Correo Electrónico</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="ejemplo@correo.com" />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label fw-semibold">Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rol" class="form-label fw-semibold">Rol asignado</label>
                <select asp-for="Rol" asp-items="Model.Roles" class="form-select">
                    <option value="">Seleccione un rol...</option>
                </select>
                <span asp-validation-for="Rol" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="AreaId" class="form-label fw-semibold">Área de trabajo</label>
                <select asp-for="AreaId" asp-items="Model.Areas" class="form-select">
                    <option value="">Seleccione una área...</option>
                </select>
                <span asp-validation-for="AreaId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TipoFirmaId" class="form-label fw-semibold">Tipo de Firma</label>
                <select asp-for="TipoFirmaId" asp-items="Model.TiposFirma" class="form-select">
                    <option value="">Seleccione tipo de firma...</option>
                </select>
                <span asp-validation-for="TipoFirmaId" class="text-danger small"></span>
            </div>

            <div class="d-flex gap-2 pt-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="bi bi-save me-1"></i>Guardar Usuario
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    Cancelar
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts {
    <!-- Script opcional para validar en el cliente sin recargar la página -->
    <partial name="_ValidationScriptsPartial" />
}
