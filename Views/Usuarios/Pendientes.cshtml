@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Usuarios Pendientes";
}

<!-- CDN de DataTables con Estilos de Bootstrap 5 -->

<link rel="stylesheet" href="https://cdn.datatables.net/2.3.8/css/dataTables.dataTables.min.css" />

<div class="container-fluid py-4">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }
    
    <div class="card shadow-sm border-0 rounded-3">

        <div class="card-header bg-white py-3 border-bottom border-light">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h3 class="fw-bold text-dark mb-1">
                        <i class="bi bi-shield-lock me-2 text-primary"></i>Solicitudes de Acceso
                    </h3>
                    <p class="text-muted mb-0 small">
                        Usuarios registrados en la planta pendientes de autorización en el sistema
                    </p>
                </div>

                <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill fw-semibold shadow-sm">
                    <i class="bi bi-clock-history me-1"></i>@(Model?.Count() ?? 0) Pendientes
                </span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">
                <table id="tablaPendientes" class="table table-striped table-hover align-middle w-100 mb-0" style="font-size: 0.9rem;">
                    <thead class="table-dark text-uppercase" style="font-size: 0.8rem; letter-spacing: 0.05em;">
                        <tr>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th>Fecha Solicitud</th>
                            <th>Estatus</th>
                            <th class="text-center" style="width: 220px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var usuario in Model)
                            {
                                <tr>
                                    <td class="fw-semibold text-secondary">
                                        <i class="bi bi-person-circle me-2 text-primary fs-5 align-middle"></i>
                                        <span class="align-middle">@usuario.NombreCompleto</span>
                                    </td>
                                    <td>
                                        <a href="mailto:@usuario.Email" class="text-decoration-none text-dark font-monospace">@usuario.Email</a>
                                    </td>
                                    <td class="text-muted">
                                        <!-- Control de nulabilidad por seguridad si la fecha es opcional -->
                                        @(usuario.FechaSolicitudAcceso != null
                                                                        ? usuario.FechaSolicitudAcceso.ToString("dd/MM/yyyy HH:mm")
                                                                        : "-")
                            </td>
                            <td>
                                <span class="badge bg-warning text-dark px-2.5 py-1.5 rounded-pill fw-semibold">
                                    <span class="p-1 bg-dark rounded-circle d-inline-block me-1" style="width:4px; height:4px; vertical-align:middle;"></span>Pendiente
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    <!-- CORRECCIÓN: Se abre correctamente la etiqueta <a> con sus Tag Helpers de C# -->
                                    <button type="button"
                                            class="btn btn-success btn-sm px-3 fw-medium d-inline-flex align-items-center gap-1 shadow-sm btn-aprobar"
                                            data-id="@usuario.Id"
                                            data-nombre="@usuario.NombreCompleto"
                                            data-email="@usuario.Email">

                                                <i class="bi bi-check-circle-fill"></i>
                                                Aprobar

                                    </button>

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm px-3 fw-medium d-inline-flex align-items-center gap-1 btn-rechazar shadow-sm"
                                                    data-id="@usuario.Id"
                                                    data-nombre="@usuario.NombreCompleto">
                                                <i class="bi bi-x-circle-fill"></i> Rechazar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                                }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    <i class="bi bi-patch-check text-success me-2 fs-5"></i>No hay solicitudes de acceso pendientes de revisar.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="modal fade"
             id="modalAprobarUsuario"
             tabindex="-1"
             aria-hidden="true">

            <div class="modal-dialog modal-lg modal-dialog-centered">

                <div class="modal-content border-0 shadow">

                    <!-- ✅ CORRECCIÓN: Se añade la etiqueta de apertura <form> con Tag Helpers de ASP.NET Core -->
                    <form asp-controller="Usuarios" asp-action="Aprobar" method="post">

                        @Html.AntiForgeryToken()

                        <div class="modal-header bg-success text-white py-3">

                            <h5 class="modal-title fw-bold">
                                <i class="bi bi-person-check-fill me-2"></i>Autorizar y Configurar Usuario
                            </h5>

                            <button type="button"
                                    class="btn-close btn-close-white"
                                    data-bs-dismiss="modal"
                                    aria-label="Close">
                            </button>

                        </div>

                        <div class="modal-body p-4">

                            <input type="hidden"
                                   id="UsuarioId"
                                   name="UsuarioId" />

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-secondary small">Nombre</label>
                                    <input id="NombreUsuario"
                                           class="form-control bg-light"
                                           readonly />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-semibold text-secondary small">Correo Electrónico</label>
                                    <input id="CorreoUsuario"
                                           class="form-control bg-light font-monospace"
                                           readonly />
                                </div>

                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold text-secondary small">Asignar Rol Principal</label>
                                <select name="RolSeleccionado"
                                        class="form-select"
                                        required>
                                    <option value="">Seleccione un rol...</option>
                                    <option value="Administrador">Administrador</option>
                                    <option value="Aprobador">Aprobador</option>
                                    <option value="Usuario">Usuario</option>
                                </select>
                            </div>

                            <div class="card border-0 shadow-sm mb-3">

                                <div class="card-header bg-light">

                                    <h6 class="mb-0 fw-bold">

                                        <i class="bi bi-vector-pen me-2"></i>

                                        Tipos de Firma

                                    </h6>

                                </div>

                                <div class="card-body">

                                    <div class="row g-2"
                                         id="contenedorFirmas">
                                    </div>

                                </div>

                            </div>

                            <div class="card border-0 shadow-sm">

                                <div class="card-header bg-light">

                                    <h6 class="mb-0 fw-bold">

                                        <i class="bi bi-diagram-3-fill me-2"></i>

                                        Áreas Operativas

                                    </h6>

                                </div>

                                <div class="card-body">

                                    <div class="row g-2"
                                         id="contenedorAreas">
                                    </div>

                                </div>

                            </div>

                        </div>

                        <div class="modal-footer bg-light py-3">

                            <button type="button"
                                    class="btn btn-secondary px-3"
                                    data-bs-dismiss="modal">
                                Cancelar
                            </button>

                            <button type="submit"
                                    class="btn btn-success px-4 fw-medium">
                                <i class="bi bi-shield-check me-2"></i>Autorizar Usuario
                            </button>

                        </div>

                    </form> <!-- El cierre que ya tenías original -->

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="https://cdn.datatables.net/v/dt/dt-3.0.1/datatables.min.js" ></script>
    <script>

        $(document).on('click', '.btn-rechazar', function () {

            const userId = $(this).data('id');
            const userNombre = $(this).data('nombre');

            if (confirm(`¿Rechazar la solicitud de ${userNombre}?`)) {

                fetch('/Usuarios/Rechazar', {

                    method: 'POST',

                    headers: {
                        'Content-Type':
                            'application/x-www-form-urlencoded'
                    },

                    body: `id=${userId}`

                })
                .then(() => location.reload());
            }
        });
                $(document).ready(function () {

            const filas = $('#tablaPendientes tbody tr').length;

            if (filas > 0 &&
                !$('#tablaPendientes tbody td[colspan]').length) {

                $('#tablaPendientes').DataTable({
                    pageLength: 10,
                    responsive: true,
                    order: [[2, "desc"]],
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.13.8/i18n/es-MX.json'
                    }
                });
            }
        });

         const modalAprobar = new bootstrap.Modal(document.getElementById('modalAprobarUsuario'));

        $(document).on('click', '.btn-aprobar', function () {

            const id = $(this).data('id');

            $.get(
                '/Usuarios/ObtenerDatosAprobacion',
                { id: id },
                function (data) {

                    $('#UsuarioId').val(data.usuarioId);

                    $('#NombreUsuario')
                        .val(data.nombreCompleto);

                    $('#CorreoUsuario')
                        .val(data.email);

                    let rolesHtml = '';

                    data.roles.forEach(r => {

                        rolesHtml += `
                            <option value="${r.value}">
                                ${r.text}
                            </option>
                        `;
                    });

                    $('select[name="RolSeleccionado"]')
                        .html(rolesHtml);

                    let areasHtml = '';

                    data.areas.forEach(a => {

                        areasHtml += `
                            <option value="${a.value}">
                                ${a.text}
                            </option>
                        `;
                    });

                   $('#contenedorAreas').empty();

                    data.areas.forEach(a => {

                        $('#contenedorAreas').append(`

                            <div class="col-md-4">

                                <div class="form-check">

                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="AreasSeleccionadas"
                                           value="${a.value}"
                                           id="area_${a.value}" />

                                    <label class="form-check-label"
                                           for="area_${a.value}">

                                        ${a.text}

                                    </label>

                                </div>

                            </div>

                        `);

                    });
                    $('#contenedorFirmas').empty();

                    data.firmas.forEach(f => {

                        $('#contenedorFirmas').append(`

                            <div class="col-md-4">

                                <div class="form-check">

                                    <input class="form-check-input"
                                            type="checkbox"
                                            name="TiposFirmaSeleccionados"
                                            value="${f.value}"
                                            id="firma_${f.value}" />

                                    <label class="form-check-label"
                                            for="firma_${f.value}">

                                        ${f.text}

                                    </label>

                                </div>

                            </div>

                        `);

                    });


                    modalAprobar.show();
                });

        });

    </script>
}
