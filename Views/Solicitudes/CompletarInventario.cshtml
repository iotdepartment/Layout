@model Layout.Models.ViewModels.SolicitudInventarioViewModel

<style>
    .transition {
        transition: all 0.2s ease-in-out;
    }

    .hover-shadow-sm:hover {
        transform: translateY(-2px);
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075) !important;
        background-color: #ffffff !important;
        border-color: #0d6efd !important; /* Color primario al enfocar */
    }

</style>
<div asp-validation-summary="All" class="mb-4 d-none" role="alert"></div>

<input type="hidden"
       id="solicitudId"
       value="@Model.SolicitudId" />
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-4">
        <form asp-action="CompletarInventario" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="SolicitudId" />

            <!-- Encabezado de Sección -->
            <div class="d-flex align-items-center mb-4 border-bottom pb-2">
                <i class="bi bi-gear-wide-connected text-primary fs-4 me-2"></i>
                <h5 class="card-title mb-0 fw-semibold text-secondary">Revisión de Movimientos</h5>
            </div>

            <!-- Contenedor Grid para los Checkboxes -->
            <div class="row g-3 mb-4">
                <div class="col-md-6 col-lg-4">
                    <div class="form-check form-switch p-3 border rounded-3 bg-light h-100 hover-shadow-sm transition">
                        <input class="form-check-input ms-0 me-2 float-start" type="checkbox" asp-for="MovimientoITIoT" />
                        <label class="form-check-label fw-medium text-dark" asp-for="MovimientoITIoT">
                            Movimiento de Redes y/o Sistemas (IT/IoT)
                        </label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="form-check form-switch p-3 border rounded-3 bg-light h-100 hover-shadow-sm transition">
                        <input class="form-check-input ms-0 me-2 float-start" type="checkbox" asp-for="MovimientoProgramacion" />
                        <label class="form-check-label fw-medium text-dark" asp-for="MovimientoProgramacion">
                            Movimientos de Programación
                        </label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="form-check form-switch p-3 border rounded-3 bg-light h-100 hover-shadow-sm transition">
                        <input class="form-check-input ms-0 me-2 float-start" type="checkbox" asp-for="MovimientoElectrico" />
                        <label class="form-check-label fw-medium text-dark" asp-for="MovimientoElectrico">
                            Movimientos eléctricos y/o Neumaticos
                        </label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="form-check form-switch p-3 border rounded-3 bg-light h-100 hover-shadow-sm transition">
                        <input class="form-check-input ms-0 me-2 float-start" type="checkbox" asp-for="MovimientoEHS" />
                        <label class="form-check-label fw-medium text-dark" asp-for="MovimientoEHS">
                            ¿El Movimiento involucra reubicar equipos de EHS?
                        </label>
                    </div>
                </div>

                <div class="col-md-6 col-lg-4">
                    <div class="form-check form-switch p-3 border rounded-3 bg-light h-100 hover-shadow-sm transition">
                        <input class="form-check-input ms-0 me-2 float-start" type="checkbox" asp-for="CambioNomenclatura" />
                        <label class="form-check-label fw-medium text-dark" asp-for="CambioNomenclatura">
                            ¿La nomenclatura de las mesas será modificada?
                        </label>
                    </div>
                </div>
            </div>

            <!-- Sección Condicional: Requiere PCR -->
            <div class="card bg-light border-0 rounded-3 p-3 mb-4">
                <div class="row align-items-center g-3">
                    <div class="col-md-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="RequierePCR" id="chkPCR" />
                            <label class="form-check-label fw-bold text-primary" for="chkPCR">
                                ¿Este movimiento requiere someter un PCR?
                            </label>
                        </div>
                    </div>
                    <div class="col-md-8">
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted">
                                <i class="bi bi-hash"></i>
                            </span>
                            <input asp-for="NumeroPCR" id="txtPCR" class="form-control border-start-0 ps-0" placeholder="Número PCR" readonly />
                        </div>
                        <span asp-validation-for="NumeroPCR" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>
            </div>

            <hr />

            <h5 class="mb-4">
                Evidencia Fotográfica
            </h5>

            <div class="row">

                <!-- IMAGEN ANTES -->
                <div class="col-md-6">

                    <label asp-for="ImagenAntes" class="form-label fw-semibold">
                        Imagen Antes
                    </label>

                    <input asp-for="ImagenAntes"
                           type="file"
                           class="form-control"
                           accept="image/*"
                           id="imgAntesInput" />

                    <div class="mt-3 text-center d-none"
                         id="previewAntesContainer">

                        <img id="previewAntes"
                             class="img-fluid rounded shadow-sm border"
                             style="max-height:300px; width:100%; object-fit:contain;" />

                    </div>

                </div>

                <!-- IMAGEN DESPUÉS -->
                <div class="col-md-6">

                    <label asp-for="ImagenDespues" class="form-label fw-semibold">
                        Imagen Después
                    </label>

                    <input asp-for="ImagenDespues"
                           type="file"
                           class="form-control"
                           accept="image/*"
                           id="imgDespuesInput" />

                    <div class="mt-3 text-center d-none"
                         id="previewDespuesContainer">

                        <img id="previewDespues"
                             class="img-fluid rounded shadow-sm border"
                             style="max-height:300px; width:100%; object-fit:contain;" />

                    </div>

                </div>

            </div>

            <hr />

            <div class="d-flex align-items-center mb-4 border-bottom pb-2">
                <i class="bi bi-pen text-primary fs-4 me-2"></i>
                <h5 class="card-title mb-0 fw-semibold text-secondary">
                    Firmas Requeridas
                </h5>
            </div>

            <div class="card bg-light border-0 rounded-3 p-3 mb-4">

                <div id="contenedorFirmas">

                    <div class="firma-row row g-3 mb-3">

                        <div class="col-md-5">

                            <label class="form-label fw-semibold">
                                Tipo de Firma
                            </label>

                            <select class="form-select firma-tipo"
                                    name="Firmas[0].TipoFirmaId">

                                <option value="">
                                    Seleccione...
                                </option>

                                @foreach (var firma in ViewBag.TiposFirma)
                                {
                                    <option value="@firma.Id">
                                        @firma.Nombre
                                    </option>
                                }

                            </select>

                        </div>

                        <div class="col-md-5">

                            <label class="form-label fw-semibold">
                                Usuario Responsable
                            </label>

                            <select class="form-select firma-usuario"
                                    name="Firmas[0].UsuarioRequeridoId">

                                <option value="">
                                    Seleccione un usuario
                                </option>

                            </select>

                        </div>

                        <div class="col-md-2 d-flex align-items-end">

                            <button type="button"
                                    class="btn btn-outline-danger w-100 btnEliminarFirma">

                                <i class="bi bi-trash"></i>

                            </button>

                        </div>

                    </div>

                </div>

                <div class="text-end">

                    <button type="button"
                            class="btn btn-outline-primary"
                            id="btnAgregarFirma">

                        <i class="bi bi-plus-circle me-1"></i>
                        Agregar Firma

                    </button>

                </div>

            </div>

            <hr />


            <!-- Botones de Acción Formulario -->
            <div class="d-flex justify-content-end gap-2 pt-2">
                <button type="button" class="btn btn-light border px-4">Cancelar</button>
                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-check-circle me-1"></i> Guardar
                </button>
            </div>


        </form>
    </div>
</div>

@section Scripts {
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            // 1. Controlar la visibilidad de la alerta de validación
            // Buscamos el div por su atributo de validación de ASP.NET
            const validationSummary = document.querySelector('[asp-validation-summary]');

            if (validationSummary) {
                // ASP.NET genera un "<ul><li>" oculto o vacío si no hay errores.
                // Buscamos si realmente hay algún texto de error dentro de la lista.
                const hasErrors = validationSummary.innerText.trim().length > 0;

                if (!hasErrors) {
                    validationSummary.classList.add('d-none');
                } else {
                    // Si hay errores, nos aseguramos de que sea visible y tenga estilo de alerta
                    validationSummary.classList.remove('d-none');
                    validationSummary.classList.add('alert', 'alert-danger');
                }
            }

            // 2. Control del Input Condicional (PCR)
            function initToggleInput(checkId, inputId) {
                const chk = document.getElementById(checkId);
                const input = document.getElementById(inputId);

                if (!chk || !input) return;

                // Estado inicial al cargar la página (mantiene el valor si el servidor rechazó el formulario)
                input.readOnly = !chk.checked;

                // Evento de cambio al hacer clic
                chk.addEventListener("change", function () {
                    input.readOnly = !this.checked;
                    if (!this.checked) {
                        input.value = "";
                    } else {
                        input.focus(); // Enfoca automáticamente el campo al activarse
                    }
                });
            }

            // Inicializar la función
            initToggleInput("chkPCR", "txtPCR");

        // =========================
        // PREVIEW IMAGEN ANTES
        // =========================

        const imgAntesInput = document.getElementById("imgAntesInput");
        const previewAntes = document.getElementById("previewAntes");
        const previewAntesContainer = document.getElementById("previewAntesContainer");

        imgAntesInput?.addEventListener("change", function () {

            const archivo = this.files[0];

            if (!archivo) {
                previewAntesContainer.classList.add("d-none");
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                previewAntes.src = e.target.result;
                previewAntesContainer.classList.remove("d-none");
            };

            reader.readAsDataURL(archivo);
        });

        // =========================
        // PREVIEW IMAGEN DESPUÉS
        // =========================

        const imgDespuesInput = document.getElementById("imgDespuesInput");
        const previewDespues = document.getElementById("previewDespues");
        const previewDespuesContainer = document.getElementById("previewDespuesContainer");

        imgDespuesInput?.addEventListener("change", function () {

            const archivo = this.files[0];

            if (!archivo) {
                previewDespuesContainer.classList.add("d-none");
                return;
            }

            const reader = new FileReader();

            reader.onload = function (e) {
                previewDespues.src = e.target.result;
                previewDespuesContainer.classList.remove("d-none");
            };

            reader.readAsDataURL(archivo);
        });
        });
    </script>
    
    <script>
                let indiceFirma = 1;

        document
            .getElementById("btnAgregarFirma")
            ?.addEventListener("click", function () {

                const contenedor =
                    document.getElementById("contenedorFirmas");

                const primeraFila =
                    document.querySelector(".firma-row");

                const nuevaFila =
                    primeraFila.cloneNode(true);

                nuevaFila.querySelectorAll("select")
                    .forEach(select => {

                        if (select.name.includes("TipoFirmaId")) {

                            select.name =
                                `Firmas[${indiceFirma}].TipoFirmaId`;

                            select.selectedIndex = 0;
                        }

                        if (select.name.includes("UsuarioRequeridoId")) {

                            select.name =
                                `Firmas[${indiceFirma}].UsuarioRequeridoId`;

                            select.selectedIndex = 0;
                        }
                    });

                contenedor.appendChild(nuevaFila);

                indiceFirma++;
            });

        document.addEventListener("click", function (e) {

            if (
                e.target.closest(".btnEliminarFirma")
            ) {

                const filas =
                    document.querySelectorAll(".firma-row");

                if (filas.length > 1) {

                    e.target
                        .closest(".firma-row")
                        .remove();
                }
            }
        });

                document.addEventListener("change", async function (e) {

            if (!e.target.classList.contains("firma-tipo"))
                return;

            const tipoFirmaId = e.target.value;

            const fila =
                e.target.closest(".firma-row");

            const comboUsuario =
                fila.querySelector(".firma-usuario");

            const solicitudId =
                document.getElementById("solicitudId").value;

            comboUsuario.innerHTML =
                '<option value="">Cargando...</option>';

            const response =
                await fetch(
                    `/Solicitudes/ObtenerUsuariosFirma?tipoFirmaId=${tipoFirmaId}&solicitudId=${solicitudId}`
                );

            const usuarios =
                await response.json();

            comboUsuario.innerHTML =
                '<option value="">Seleccione usuario</option>';

            usuarios.forEach(usuario => {

                comboUsuario.innerHTML +=
                    `<option value="${usuario.id}">
                        ${usuario.nombre}
                     </option>`;
            });

        });
    </script>
}

