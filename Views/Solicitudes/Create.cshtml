@model Layout.Models.ViewModels.SolicitudCreateViewModel

@{
    ViewData["Title"] = "Nueva Solicitud";
}
<style>
    /* ==========================================================================
       ESTILOS PREMIUM PARA FORMULARIO DE INVENTARIO INTERACTIVO
       ========================================================================== */

    /* Contenedor que agrupa los campos en un flujo limpio */
    .form-inventory-card {
        background-color: #ffffff;
        border: 1px solid #eef1f6;
        border-radius: 16px;
        padding: 20px;
    }

    /* Celda individual para cada parámetro técnico */
    .form-inventory-row {
        background-color: #fcfcfc;
        border: 1px solid #f1f3f9;
        border-radius: 12px;
        padding: 14px 16px;
        transition: all 0.25s ease;
    }

        /* Estado visual cuando el parámetro está activado */
        .form-inventory-row.active-row {
            background-color: #fafbfe;
            border-color: #d1dff8;
            box-shadow: 0 4px 12px rgba(78, 115, 223, 0.04);
        }

    /* Estilo para las etiquetas de control */
    .form-inventory-label {
        font-size: 0.9rem;
        font-weight: 600;
        color: #495057;
        margin-bottom: 0;
        cursor: pointer;
    }

    /* Estilo para los inputs y textareas del formulario */
    .form-inventory-control {
        border-radius: 8px;
        padding: 10px 12px;
        border: 1px solid #ced4da;
        background-color: #f8fafc;
        transition: all 0.15s ease;
    }

        .form-inventory-control:focus {
            background-color: #ffffff;
            border-color: #4e73df;
            box-shadow: 0 0 0 0.2rem rgba(78, 115, 223, 0.1);
        }

    /* Personalización del interruptor switch de Bootstrap */
    .form-switch .form-check-input {
        width: 2.5em;
        height: 1.25em;
        cursor: pointer;
    }

</style>

<div class="row justify-content-center mt-4">
    <div class="col-lg-8 col-md-10">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white p-3">
                <h3 class="card-title mb-0 h5"><i class="bi bi-file-earmark-plus me-2"></i>Nueva Solicitud de Movimiento</h3>
            </div>
            <div class="card-body p-4">

                <!-- Contenedor dinámico para alertas globales de Fetch -->
                <div id="alertContainer"></div>

                <form id="formSolicitud" asp-action="Create" method="post" enctype="multipart/form-data" novalidate>

                    <!-- Token Antiforgery oculto automático de ASP.NET Core -->
                    @Html.AntiForgeryToken()

                    <div class="row">
                        <!-- Área -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="AreaId" class="form-label fw-bold small text-secondary">Área</label>
                            <select asp-for="AreaId" asp-items="Model.Areas" class="form-select form-control-modern" required>
                                <option value="">Seleccione un área...</option>
                            </select>
                            <span asp-validation-for="AreaId" class="text-danger small"></span>
                        </div>

                        <!-- Tipo Movimiento -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="TipoMovimiento" class="form-label fw-bold small text-secondary">Tipo de Movimiento</label>
                            <select asp-for="TipoMovimiento" class="form-select form-control-modern"
                                    asp-items="Html.GetEnumSelectList<Layout.Models.Enums.TipoMovimiento>()" required>
                            </select>
                            <span asp-validation-for="TipoMovimiento" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Razón -->
                    <div class="mb-3">
                        <label asp-for="Razon" class="form-label fw-bold small text-secondary">Motivos para solicitar el movimiento de Layout:</></label>
                        <textarea asp-for="Razon" class="form-control form-control-modern" rows="3" placeholder="¿Por qué se requiere este movimiento?"></textarea>
                        <span asp-validation-for="Razon" class="text-danger small"></span>
                    </div>

                    <!-- Descripción -->
                    <div class="mb-3">
                        <label asp-for="Descripcion" class="form-label fw-bold small text-secondary">Detallar el movimiento requerido:</label>
                        <textarea asp-for="Descripcion" class="form-control form-control-modern" rows="3" placeholder="Detalla brevemente la solicitud..."></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger small"></span>
                    </div>

                    <!-- Imagen -->
                    <small class="bg-danger-subtle text-danger fw-bold">En revision</small>
                    <div class="mb-4 border-3 border-dark border" disabled>
                       
                        <label asp-for="Imagen" class="form-label fw-bold small text-secondary" >Dibujo o Layout (Imagen)</label>
                        <input  type="file" asp-for="Imagen" class="form-control form-control-modern" accept="image/*" />
                        <div class="form-text small">Archivos sugeridos: PNG, JPG, JPEG.</div>
                        <span asp-validation-for="Imagen" class="text-danger small"></span>
                    </div>
                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaInicioMovimiento" class="fw-semibold">
                                Fecha a partir de
                            </label>

                            <input asp-for="FechaInicioMovimiento"
                                   type="date"
                                   class="form-control"
                                   id="fechaInicio" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="FechaFinMovimiento" class="fw-semibold">
                                Fecha de terminación
                            </label>

                            <input asp-for="FechaFinMovimiento"
                                   type="date"
                                   class="form-control"
                                   id="fechaFin" />
                        </div>

                    </div>


                    <hr class="mt-4" />
                    <div class="form-inventory-card shadow-sm">

                        <h5 class="text-primary fw-bold mb-4 d-flex align-items-center">
                            <i class="bi bi-box-seam me-2 fs-4"></i>Información Técnica de Inventario
                        </h5>

                        <div class="row g-3">

                           @*  <!-- 1. NÚMERO DE VALIDACIÓN -->
                            <div class="col-12">
                                <div class="form-inventory-row" id="rowValidacion">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-inventory-label" for="chkValidacion">
                                            <i class="bi bi-hash text-muted me-1.5"></i>Número de Validación
                                        </label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input inventory-switch" type="checkbox" id="chkValidacion" asp-for="AplicaValidacion" data-target="txtValidacion" data-row="rowValidacion" />
                                        </div>
                                    </div>
                                    <input id="txtValidacion" asp-for="NumeroValidacion" class="form-control form-inventory-control" placeholder="Ingrese el folio de validación..." readonly />
                                    <span asp-validation-for="NumeroValidacion" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div> *@

                            <!-- 2. RESPONSABLE INVENTARIO -->
                            <div class="col-12">
                                <div class="form-inventory-row" id="rowResponsable">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-inventory-label" for="chkResponsable">
                                            <i class="bi bi-person text-muted me-1.5"></i>Responsable de Inventario
                                        </label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input inventory-switch" type="checkbox" id="chkResponsable" asp-for="AplicaResponsable" data-target="txtResponsable" data-row="rowResponsable" />
                                        </div>
                                    </div>
                                    <input id="txtResponsable" asp-for="ResponsableInventario" class="form-control form-inventory-control" placeholder="Nombre completo del responsable..." readonly />
                                    <span asp-validation-for="ResponsableInventario" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- 3. MANDRIL / KANBAN / NP -->
                            <div class="col-12">
                                <div class="form-inventory-row" id="rowMandril">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-inventory-label" for="chkMandril">
                                            <i class="bi bi-tag text-muted me-1.5"></i>Mandril / Kanban / Número Parte
                                        </label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input inventory-switch" type="checkbox" id="chkMandril" asp-for="AplicaMandril" data-target="txtMandril" data-row="rowMandril" />
                                        </div>
                                    </div>
                                    <input id="txtMandril" asp-for="MandrilKanbanNP" class="form-control form-inventory-control" placeholder="Escriba el identificador correspondiente..." readonly />
                                    <span asp-validation-for="MandrilKanbanNP" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- 4. NÚMERO DE PALLETS -->
                            <div class="col-12">
                                <div class="form-inventory-row" id="rowPallets">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-inventory-label" for="chkPallets">
                                            <i class="bi bi-layers text-muted me-1.5"></i>Cantidad de Pallets
                                        </label>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input inventory-switch" type="checkbox" id="chkPallets" asp-for="AplicaPallets" data-target="txtPallets" data-row="rowPallets" />
                                        </div>
                                    </div>
                                    <input id="txtPallets" asp-for="NumeroPallets" type="number" class="form-control form-inventory-control" placeholder="Ej. 5" readonly />
                                    <span asp-validation-for="NumeroPallets" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                            <!-- 5. RAZÓN INVENTARIO -->
                            <div class="col-12">
                                <div class="form-inventory-row" id="rowRazonInv">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <label class="form-inventory-label" for="chkRazonInv">
                                            <i class="bi bi-chat-left-text text-muted me-1.5"></i>Razón de Inventario
                                        </label>
                                        <div class="form-check form-switch">
                                            <!-- Nota: Corregido asp-for a 'AplicaRazon' según tu controlador HttpPost de C# -->
                                            <input class="form-check-input inventory-switch" type="checkbox" id="chkRazonInv" asp-for="AplicaRazonInventario" data-target="txtRazonInv" data-row="rowRazonInv" />
                                        </div>
                                    </div>
                                    <textarea id="txtRazonInv" asp-for="RazonInventario" class="form-control form-inventory-control" rows="2" placeholder="Describa detalladamente los motivos técnicos de inventario..." readonly></textarea>
                                    <span asp-validation-for="RazonInventario" class="text-danger small mt-1 d-block"></span>
                                </div>
                            </div>

                        </div>
                    </div>

                  
                    <!-- Botones -->
                    <div class="d-flex justify-content-end gap-2  pt-3">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-light px-4">Cancelar</a>
                        <button type="submit" id="btnGuardar" class="btn btn-primary px-4">
                            <span id="btnText">Guardar Solicitud</span>
                            <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
            document
        .getElementById("fechaInicio")
        .addEventListener("change", function () {

            document
                .getElementById("fechaFin")
                .min = this.value;
        });
        const switches = document.querySelectorAll('.inventory-switch');

        function evaluarSwitch(checkbox) {
            const idInput = checkbox.getAttribute('data-target');
            const idRow = checkbox.getAttribute('data-row');
            const inputControl = document.getElementById(idInput);
            const filaContenedora = document.getElementById(idRow);

            if (checkbox.checked) {
                // Activado: Habilitamos escritura, cambiamos fondo y agregamos clase estética
                inputControl.removeAttribute('readonly');
                filaContenedora.classList.add('active-row');
                inputControl.style.backgroundColor = "#ffffff";
            } else {
                // Desactivado: Bloqueamos campo, limpiamos texto y removemos diseño activo
                inputControl.setAttribute('readonly', 'true');
                inputControl.value = "";
                filaContenedora.classList.remove('active-row');
                inputControl.style.backgroundColor = "#f8fafc";
            }
        }

        // Evaluamos el estado inicial de los campos (por si la vista carga datos previamente guardados)
        switches.forEach(checkbox => {
            evaluarSwitch(checkbox);

            // Escuchamos los clics de cambio del usuario
            checkbox.addEventListener('change', function () {
                evaluarSwitch(this);
            });
        });
        function toggleInput(checkId, inputId) {
            const chk = document.getElementById(checkId);
            const input = document.getElementById(inputId);

            if (!chk || !input) return;

            input.readOnly = !chk.checked;

            chk.addEventListener("change", function () {
                input.readOnly = !this.checked;

                if (!this.checked) {
                    input.value = "";
                }
            });
        }

        // Inicialización
        toggleInput("chkResponsable", "txtResponsable");
        toggleInput("chkMandril", "txtMandril");
        toggleInput("chkPallets", "txtPallets");
        toggleInput("chkRazonInv", "txtRazonInv");
        toggleInput("chkFecha", "txtFecha");
        document.getElementById('formSolicitud').addEventListener('submit', async function (e) {
            e.preventDefault(); // Evitamos que la página recargue de forma tradicional

            const form = this;
            const btnGuardar = document.getElementById('btnGuardar');
            const btnText = document.getElementById('btnText');
            const btnSpinner = document.getElementById('btnSpinner');
            const alertContainer = document.getElementById('alertContainer');

            // Limpiar alertas previas
            alertContainer.innerHTML = '';
                    // ====================================
        // VALIDACIONES CONDICIONALES INVENTARIO
        // ====================================

        const errores = [];

       

        if ($("#chkResponsable").is(":checked") &&
            !$("#txtResponsable").val().trim()) {
            errores.push("Debe capturar el Responsable de Inventario.");
        }

        if ($("#chkMandril").is(":checked") &&
            !$("#txtMandril").val().trim()) {
            errores.push("Debe capturar Mandril / Kanban / NP.");
        }

        if ($("#chkPallets").is(":checked") &&
            !$("#txtPallets").val().trim()) {
            errores.push("Debe capturar el número de pallets.");
        }

        if ($("#chkRazonInv").is(":checked") &&
            !$("#txtRazonInv").val().trim()) {
            errores.push("Debe capturar la Razón de Inventario.");
        }

        if (errores.length > 0) {

            let html = `
                <div class="alert alert-danger">
                    <strong>Favor de completar la información requerida:</strong>
                    <ul class="mb-0 mt-2">
            `;

            errores.forEach(e => {
                html += `<li>${e}</li>`;
            });

            html += `
                    </ul>
                </div>
            `;

            alertContainer.innerHTML = html;

            return false;
        }
            // Forzar gatillo de validación nativa de jQuery Validation de ASP.NET Core
            if (!$(form).valid()) {
                return false;
            }

            // Deshabilitar botón y activar spinner de carga
            btnGuardar.disabled = true;
            btnText.innerText = "Procesando...";
            btnSpinner.classList.remove('d-none');

            // Recopilar los datos del formulario (Automáticamente añade archivos/imágenes del input type="file")
            const formData = new FormData(form);

            try {
                const response = await fetch(form.action, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        // El RequestVerificationToken se añade solo gracias a FormData si el form tiene el Tag Helper
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                });

                if (!response.ok) {
                    throw new Error('Error en la comunicación con el servidor.');
                }

                const result = await response.json();

                if (result.success) {
                    // Mostrar alerta de éxito
                    alertContainer.innerHTML = `
                        <div class="alert alert-success d-flex align-items-center" role="alert">
                            <div>${result.message}. Redireccionando...</div>
                        </div>`;

                    // Esperar 1.5 segundos para que el usuario lea el éxito y luego redirigir
                    setTimeout(() => {
                        window.location.href = result.redirectUrl;
                    }, 1500);

                } else {
                    // Si el servidor retornó un fallo controlado (ej: Validación fallida)
                    let errorHtml = `<div class="alert alert-danger" role="alert"><strong>${result.message}</strong>`;
                    if (result.errors && result.errors.length > 0) {
                        errorHtml += '<ul class="mb-0 mt-2">';
                        result.errors.forEach(err => errorHtml += `<li>${err}</li>`);
                        errorHtml += '</ul>';
                    }
                    errorHtml += '</div>';

                    alertContainer.innerHTML = errorHtml;

                    // Reactivar botón si hubo fallos de negocio
                    btnGuardar.disabled = false;
                    btnText.innerText = "Guardar Solicitud";
                    // ✅ CORREGIDO: Se cambió .addClass por .classList.add
                    btnSpinner.classList.add('d-none');
                }

            } catch (error) {
                // Errores graves (caída de red, código de servidor roto, etc.)
                alertContainer.innerHTML = `
                    <div class="alert alert-danger" role="alert">
                        <strong>Error:</strong> No se pudo procesar la solicitud en este momento. (${error.message})
                    </div>`;

                btnGuardar.disabled = false;
                btnText.innerText = "Guardar Solicitud";
                // ✅ Aquí ya estaba bien, por lo que todo funcionará correctamente
                btnSpinner.classList.add('d-none');
            }
        });
    </script>
}
