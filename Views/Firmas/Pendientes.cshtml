@model Layout.Models.ViewModels.MisFirmasViewModel

@{
    ViewData["Title"] = "Mis Firmas";
}

<link rel="stylesheet"
      href="https://cdn.datatables.net/2.3.8/css/dataTables.bootstrap5.css" />

<style>

    .table-firmas th {
        font-size: .72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .8px;
        color: #858796;
        background-color: #f8f9fa;
    }

    .table-firmas td {
        vertical-align: middle;
    }

    .counter-badge {
        font-size: .8rem;
        padding: 6px 10px;
    }

    /* ==========================================================================
       ESTILOS PREMIUM PARA PESTAÑAS DE NAVEGACIÓN (TABS)
       ========================================================================== */

    /* Contenedor de la pestaña con comportamiento elástico */
    .nav-custom-tab .nav-item {
        margin-right: 6px;
    }

    /* El botón de la pestaña en su estado normal */
    .nav-custom-tab .nav-link {
        color: #64748b;
        font-weight: 600;
        font-size: 0.9rem;
        padding: 10px 20px;
        border-radius: 10px !important;
        border: 1px solid transparent;
        background-color: transparent;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    /* Comportamiento al pasar el cursor (Hover) */
    .nav-custom-tab .nav-link:hover {
        color: #334155;
        background-color: #f1f5f9;
        border-color: #e2e8f0;
    }

    /* Estado Activo: Cuando el usuario está dentro de esa pestaña */
    .nav-custom-tab .nav-link.active {
        color: #4e73df !important;
        background-color: #edf2ff !important;
        border-color: #cbd5e1 !important;
        box-shadow: 0 4px 12px rgba(78, 115, 223, 0.06);
    }

    /* Animación de pulso para el contador de notificaciones de firmas pendientes */
    .badge-pulse-alert {
        background-color: #e11d48;
        color: #ffffff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 3px 7px;
        border-radius: 20px;
        box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.4);
        animation: pulse-ring 2s infinite;
    }

    @@keyframes pulse-ring {
        0%

    {
        box-shadow: 0 0 0 0 rgba(225, 29, 72, 0.5);
    }

    70% {
        box-shadow: 0 0 0 6px rgba(225, 29, 72, 0);
    }

    100% {
        box-shadow: 0 0 0 0 rgba(225, 29, 72, 0);
    }

    }

    /* Contenedor en cuadrícula para las tarjetas de perfil */
    .pa-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 16px;
    }

    /* Tarjeta premium de perfil PA */
    .pa-profile-card {
        background: #ffffff;
        border: 1px solid #eef1f6;
        border-radius: 14px;
        padding: 16px;
        transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

        .pa-profile-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.05) !important;
            border-color: #d1dff8;
        }

    /* Círculo del avatar simulado */
    .pa-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 0.95rem;
        flex-shrink: 0;
    }

    /* Variaciones de color según la dirección de la responsabilidad */
    .bg-cover-me {
        background-color: #e0f2fe;
        color: #0369a1;
    }
    /* Azul claro */
    .bg-i-cover {
        background-color: #ecfdf5;
        color: #047857;
    }
    /* Verde claro */

</style>

<div class="card shadow-sm border-0">   

    <div class="card-header bg-white">

        <div class="d-flex justify-content-between align-items-center">

            <div>
                <h4 class="fw-bold text-secondary mb-1">
                    Mis Firmas
                </h4>

                <p class="text-muted small mb-0">
                    Seguimiento de solicitudes pendientes y realizadas
                </p>
            </div>

            <div class="d-flex gap-2">

                <span class="badge bg-warning text-dark counter-badge rounded-pill">

                    <i class="bi bi-hourglass-split me-1"></i>

                    @Model.PendientesAgrupadas.Count Pendientes

                </span>

                <span class="badge bg-success counter-badge rounded-pill">

                    <i class="bi bi-check-circle me-1"></i>

                    @Model.RealizadasAgrupadas.Count Realizadas

                </span>

            </div>

        </div>

    </div>

    <div class="card-body">
    <!-- Asegúrate de que tu contenedor principal <ul> tenga la clase 'nav-custom-tab' -->
            <ul class="nav nav-tabs border-bottom-0 nav-custom-tab" role="tablist">

                @* PESTAÑA PARA PENDIENTES - DISEÑO PREMIUM *@
                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="tabPendientes-button"
                            data-bs-toggle="tab"
                            data-bs-target="#tabPendientes"
                            type="button"
                            role="tab"
                            aria-controls="tabPendientes"
                            aria-selected="true"
                            title="Firmas pendientes de validación">

                        <!-- Ícono descriptivo integrado -->
                        <i class="bi bi-clock-history fs-5"></i>

                        <span>Pendientes</span>

                        <!-- CONTADOR DINÁMICO CON PULSO: Solo si realmente hay firmas pendientes -->
                        @if (Model.PendientesAgrupadas != null && Model.PendientesAgrupadas.Count > 0)
                        {
                            <span class="badge badge-pulse-alert ms-1">
                                @Model.PendientesAgrupadas.Count
                            </span>
                        }
                    </button>
                </li>

                @* PESTAÑA PARA REALIZADAS - DISEÑO PREMIUM *@
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="tabRealizadas-button"
                            data-bs-toggle="tab"
                            data-bs-target="#tabRealizadas"
                            type="button"
                            role="tab"
                            aria-controls="tabRealizadas"
                            aria-selected="false"
                            title="Historial de firmas realizadas">

                        <!-- Ícono descriptivo integrado -->
                        <i class="bi bi-check-circle-fill text-success fs-5"></i>

                        <span>Realizadas</span>

                        <!-- CONTADOR ESTÁTICO NEUTRO: Al ser historial, no requiere animación de alerta -->
                        @if (Model.RealizadasAgrupadas != null && Model.RealizadasAgrupadas.Count > 0)
                        {
                            <span class="badge bg-light text-secondary border rounded-pill ms-1 fw-bold" style="font-size: 0.72rem; padding: 3px 7px;">
                                @Model.RealizadasAgrupadas.Count
                            </span>
                        }
                    </button>
                </li>

           
                @* PESTAÑA PARA FIRMAS PA*@
                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="tabPA-button"
                            data-bs-toggle="tab"
                            data-bs-target="#tabPA"
                            type="button"
                            role="tab"
                            aria-controls="tabPA"
                            aria-selected="false"
                            title="Firmas de Autorización de Planta">

                        <!-- Ícono descriptivo integrado -->
                        <i class="bi bi-fingerprint fs-5"></i>

                        <span>Firmas PA</span>

                     
                    </button>
                </li>


        </ul>

        <div class="tab-content">

            <!-- TAB PENDIENTES -->
            <div class="tab-pane fade show active" id="tabPendientes" role="tabpanel">

                @if (!Model.PendientesAgrupadas.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-check-circle text-success fs-1 d-block mb-3"></i>
                        <h5 class="fw-bold text-secondary">No tienes firmas pendientes</h5>
                        <p class="mb-0 small italic">Estás al día con todas tus validaciones digitales.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table id="tablaPendientes" class="table table-hover table-firmas align-middle mb-0 w-100">
                            <thead>
                                <tr>
                                    <th>No. Validacion</th>
                                    <th>Área</th>
                                    <th>Firmas Requeridas</th>
                                    <th>Estatus</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.PendientesAgrupadas)

                                {
                                    <tr>
                                        <td class="fw-bold text-primary">
                                            
                                            @item.NumeroValidacion
                                            
                                        </td>

                                        <td class="fw-medium text-dark">
                                            <i class="bi bi-geo-alt text-secondary me-1"></i>
                                            @item.Area
                                        </td>

                                        <td>
                                            @foreach (var firma in item.TiposFirma)
                                            {
                                                <span class="badge bg-light text-secondary border me-1 mb-1">
                                                    @firma
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <span class="badge bg-warning-subtle text-warning rounded-pill px-2.5 py-1.5 fw-semibold shadow-xs d-inline-flex align-items-center">
                                                <i class="bi bi-circle-fill me-1 small" style="font-size: 0.5rem;"></i> Pendiente
                                            </span>
                                        </td>
                                        <td class="text-end pe-3">
                                            <!-- CORRECCIÓN: Enlace abierto y cerrado limpiamente con Tag Helpers -->
                                            <a asp-action="Detalle"
                                               asp-route-id="@item.FirmaIdReferencia"
                                               class="btn btn-sm btn-outline-primary rounded-pill px-3 fw-semibold d-inline-flex align-items-center shadow-xs"
                                               title="Revisar información técnica y firmar digitalmente">
                                                <i class="bi bi-pencil-square me-1.5"></i>Revisar y Firmar
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>

            <!-- TAB REALIZADAS -->
            <div class="tab-pane fade" id="tabRealizadas" role="tabpanel">

                @if (!Model.RealizadasAgrupadas.Any())
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-inbox text-muted fs-1 d-block mb-3 opacity-50"></i>
                        <h5 class="fw-bold text-secondary">
                            No existen firmas realizadas
                        </h5>
                        <p class="mb-0 small italic">
                            El historial de tus firmas procesadas aparecerá en este panel.
                        </p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table id="tablaRealizadas" class="table table-hover table-firmas align-middle mb-0 w-100">

                            <thead>
                                <tr>
                                    <th class="ps-3">Solicitud</th>
                                    <th>Área</th>
                                    <th>Firmas Realizadas</th>
                                    <th>Fecha Firma</th>
                                    <th class="text-end pe-3">Acciones</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var item in Model.RealizadasAgrupadas)
                                {
                                    <tr>
                                        <!-- Folio o ID de Solicitud -->
                                        <td class="fw-bold text-primary ps-3">
                                            #@item.Folio
                                        </td>

                                        <!-- Área -->
                                        <td class="fw-medium text-dark">
                                            <i class="bi bi-geo-alt text-secondary me-1"></i>
                                            @item.Area
                                        </td>

                                        <!-- Colección de Badges de firmas realizadas -->
                                        <td>
                                            @foreach (var firma in item.TiposFirma)
                                            {
                                                <span class="badge bg-success-subtle text-success rounded-pill me-1 mb-1 fw-semibold shadow-xs">
                                                    <i class="bi bi-shield-check-fill me-1"></i>@firma
                                                </span>
                                            }
                                        </td>

                                        <!-- Fecha de Registro -->
                                        <td class="text-secondary small font-monospace">
                                            <i class="bi bi-calendar-check me-1"></i>
                                            @(item.FechaFirma?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")
                                        </td>

                                        <!-- CORRECCIÓN: Estructura del botón de acciones unificada y limpia -->
                                        <td class="text-end pe-3">
                                            <a asp-action="Detalle"
                                               asp-route-id="@item.FirmaIdReferencia"
                                               class="btn btn-sm btn-outline-secondary rounded-pill px-3 fw-semibold d-inline-flex align-items-center shadow-xs"
                                               title="Ver historial de la solicitud procesada">
                                                <i class="bi bi-eye me-1.5"></i>Ver Solicitud
                                            </a>
                                        </td>

                                    </tr>
                                }
                            </tbody>

                        </table>

                    </div>
                }
            </div>

            <!-- TAB FIRMAS PA - DISEÑO PREMIUM -->
            <div class="tab-pane fade" id="tabPA" role="tabpanel">

                <!-- ==========================================
                BLOQUE 1: MIS SUSTITUTOS (Quién firma por mí)
                ========================================== -->
                <div class="d-flex justify-content-between align-items-center mb-3 mt-2">
                    <div>
                        <h5 class="fw-bold text-secondary mb-1" style="font-size: 1.1rem;">
                            <i class="bi bi-shield-check text-primary me-2"></i>Mis Sustitutos Autorizados
                        </h5>
                        <p class="text-muted small mb-0 fst-italic">Usuarios que tienen permitido firmar bajo tu nombre por ausencia (PA)</p>
                    </div>

                    @if (Model.PuedeAsignarPA)
                    {
                        <button class="btn btn-primary btn-sm rounded-pill px-3 shadow-sm fw-semibold d-inline-flex align-items-center"
                                data-bs-toggle="modal"
                                data-bs-target="#modalAsignarPA">
                            <i class="bi bi-person-plus me-1.5"></i>Asignar Usuario PA
                        </button>
                    }
                </div>

                @if (Model.FirmasPA != null && Model.FirmasPA.Any())
                {
                    <div class="pa-grid mb-4">
                        @foreach (var pa in Model.FirmasPA)
                        {
                            <div class="pa-profile-card shadow-xs border">
                                <div class="d-flex align-items-center gap-3">
                                    <!-- Avatar dinámico con la inicial -->
                                    <div class="pa-avatar bg-cover-me">
                                        @(string.IsNullOrEmpty(pa.UsuarioPA) ? "X" : pa.UsuarioPA.Substring(0, 1).ToUpper())
                                    </div>

                                  
                                    <div class="flex-grow-1 text-truncate">

                                        <span class="text-uppercase text-muted fw-bold d-block"
                                              style="font-size: 0.62rem; letter-spacing: 0.5px;">

                                            @pa.TipoFirma

                                        </span>

                                        <strong class="text-dark d-block text-truncate fs-6">
                                            @(pa.UsuarioPA ?? "Sin asignar")
                                        </strong>

                                        @if (pa.Activo)
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill mt-1">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                Activo

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill mt-1">

                                                <i class="bi bi-pause-circle-fill me-1"></i>

                                                Inactivo

                                            </span>
                                        }

                                        @if (!string.IsNullOrEmpty(pa.Motivo))
                                        {
                                            <small class="text-muted d-block text-truncate mt-2"
                                                   title="@pa.Motivo">

                                                <strong>Motivo:</strong>

                                                @pa.Motivo

                                            </small>
                                        }

                                    </div>

                                    <!-- Bloque de Acciones Lateral Derecha -->
                                    <div>
                                        <div class="d-flex flex-column align-items-end gap-2 prevent-modal-trigger">
                                            @if (pa.Activo)
                                            {
                                                <button class="btn btn-sm btn-outline-danger rounded-pill"
                                                        onclick="quitarPA(@pa.Id)">

                                                    <i class="bi bi-person-dash"></i>

                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success rounded-pill"
                                                        onclick="reactivarPA(@pa.Id)">

                                                    <i class="bi bi-arrow-clockwise"></i>

                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted bg-light rounded-3 border border-light mb-4 px-3">
                        <i class="bi bi-person-x text-muted fs-1 d-block mb-3 opacity-50"></i>
                        <h6 class="fw-bold text-secondary">No tienes usuarios asignados</h6>
                        <p class="mb-0 small text-muted fst-italic">Si no estás disponible, nadie podrá firmar tus solicitudes pendientes.</p>
                    </div>
                }



                <!-- ==========================================
                   BLOQUE 2: MIS COBERTURAS (Por quién firmo yo)
                   ========================================== -->
                @if (Model.SoyPADe != null && Model.SoyPADe.Any())
                {
                    <div class="divider-dashed my-4"></div>

                    <div class="mb-3">
                        <h5 class="fw-bold text-secondary mb-1" style="font-size: 1.1rem;">
                            <i class="bi bi-fingerprint text-success me-2"></i>Usuarios por los que puedo firmar Por Ausencia
                        @if (Model.PendientesPA != null && Model.PendientesPA.Any())
                        {
                            <span class="badge badge-pulse-alert ms-1">
                                @Model.PendientesPA.Count()
                            </span>
                        }
                        </h5>
                        
                        <p class="text-muted small mb-0 fst-italic ">Listado de titulares a los que tienes la facultad de firmarles por ausencia (PA)</p>
                    </div>

                    <div class="pa-grid">
                        @foreach (var item in Model.SoyPADe)
                        {
                            <div class="pa-profile-card shadow-xs border" style="border-left: 4px solid #10b981 !important;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="pa-avatar bg-i-cover">
                                        @item.UsuarioPA.Substring(0, 1).ToUpper()
                                    </div>
                                    <div class="flex-grow-1 text-truncate">
                                        <span class="text-uppercase text-muted fw-bold d-block" style="font-size: 0.62rem; letter-spacing: 0.5px;">@item.TipoFirma</span>
                                        <strong class="text-dark d-block text-truncate fs-6">@item.UsuarioPA</strong>
                                    </div>
                                    <div>
                                        <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small fw-semibold" title="Facultad de firma activa">
                                            <i class="bi bi-lightning-fill"></i> PA
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }


            </div>

        </div>

    </div>

</div>

@if (TempData["Success"] != null)
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true
            });

            toast.fire({
                icon: 'success',
                title: '@Html.Raw(TempData["Success"])'
            });

        });

    </script>
}

@if (TempData["Error"] != null)
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const toast = Swal.mixin({
                toast: true,
                position: 'top-end',
                showConfirmButton: false,
                timer: 4000,
                timerProgressBar: true
            });

            toast.fire({
                icon: 'error',
                title: '@Html.Raw(TempData["Error"])'
            });

        });

    </script>
}
@* MODAL PARA ASIGNAR UN USUARIO PARA FIRMAR POR AUSENCIA *@
<div class="modal fade" id="modalAsignarPA">

    <div class="modal-dialog">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title">
                    Asignar Firma PA
                </h5>

            </div>

            <div class="modal-body">

                <div class="mb-3">

                    <label class="form-label fw-bold">

                        Tipo de Firma

                    </label>

                    <select id="tipoFirmaPA"
                            class="form-select">
                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">

                        Usuario PA

                    </label>

                    <select id="usuarioPA"
                            class="form-select">
                    </select>

                </div>

                <div class="mb-3">

                    <label class="form-label fw-bold">

                        Motivo

                    </label>

                    <textarea id="motivoPA"class="form-control" placeholder="Escribe un motivo por el cual asignas a este usuario como PA"></textarea>

                </div>

            </div>

            <div class="modal-footer">

                <button class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cancelar

                </button>

                <button id="btnGuardarPA"
                        class="btn btn-primary">

                    Guardar

                </button>

            </div>

        </div>

    </div>

</div>


@section Scripts {
    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.js"></script>
    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.bootstrap5.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    <script>

        async function quitarPA(id)
        {
            const result = await Swal.fire({
                title: '¿Desactivar usuario PA?',
                text: 'El registro permanecerá para auditoría y podrás reactivarlo después.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, desactivar',
                cancelButtonText: 'Cancelar'
            });

            if (!result.isConfirmed)
                return;

            const formData = new FormData();

            formData.append('id', id);

            const response = await fetch('/Firmas/QuitarPA', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success)
            {
                location.reload();
            }
            else
            {
                Swal.fire({
                    title: 'Error',
                    text: 'No fue posible desactivar la asignación.',
                    icon: 'error',
                    confirmButtonColor: '#dc3545'
                });
            }
        }

        async function reactivarPA(id)
        {
            const result = await Swal.fire({
                title: '¿Reactivar usuario PA?',
                text: 'El usuario volverá a tener facultad para firmar por ausencia.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, reactivar',
                cancelButtonText: 'Cancelar'
            });

            if (!result.isConfirmed)
                return;

            const formData = new FormData();

            formData.append('id', id);

            const response = await fetch('/Firmas/ReactivarPA', {
                method: 'POST',
                body: formData
            });

            const data = await response.json();

            if (data.success)
            {
                location.reload();
            }
            else
            {
                Swal.fire({
                    title: 'Error',
                    text: 'No fue posible reactivar la asignación.',
                    icon: 'error',
                    confirmButtonColor: '#dc3545'
                });
            }
        }

    </script>

    <script>

        $(document).ready(function () {

            $('#tablaPendientes').DataTable({
                responsive: true,
                pageLength: 10,
                order: [[0, 'desc']]
            });

            $('#tablaRealizadas').DataTable({
                responsive: true,
                pageLength: 10,
                order: [[3, 'desc']]
            });

        });

    </script>

    <script>

        document
            .getElementById('modalAsignarPA')
            .addEventListener('show.bs.modal',
            async function () {

                const response =
                    await fetch('/Firmas/ObtenerDatosPA');

                const data =
                    await response.json();

                const tipoFirma =
                    document.getElementById('tipoFirmaPA');

                const usuarioPA =
                    document.getElementById('usuarioPA');

                tipoFirma.innerHTML = '';
                usuarioPA.innerHTML = '';

                data.tiposFirma.forEach(x => {

                    tipoFirma.innerHTML += `
                        <option value="${x.id}">
                            ${x.texto}
                        </option>
                    `;

                });

                data.usuarios.forEach(x => {

                    usuarioPA.innerHTML += `
                        <option value="${x.id}">
                            ${x.texto}
                        </option>
                    `;

                });

            });

    </script>

    <script>

        document
            .getElementById('btnGuardarPA')
            .addEventListener('click',
            async function () {

                const tipoFirmaId =
                    document.getElementById('tipoFirmaPA').value;

                const usuarioPAId =
                    document.getElementById('usuarioPA').value;

                const motivo =
                    document.getElementById('motivoPA').value;

                const formData = new FormData();

                formData.append(
                    'tipoFirmaId',
                    tipoFirmaId);

                formData.append(
                    'usuarioPAId',
                    usuarioPAId);

                formData.append(
                    'motivo',
                    motivo);

                const response =
                    await fetch(
                        '/Firmas/AsignarPA',
                        {
                            method: 'POST',
                            body: formData
                        });

                const result =
                    await response.json();

                if (result.success) {

                    location.reload();

                } else {

                    alert(
                        'No fue posible guardar el PA.'
                    );

                }

            });

    </script>

   
}