    @model SolicitudFirma

    @{
        ViewData["Title"] = $"Revisión de Solicitud #{Model.SolicitudId}";
    }

     <style>
    /* --- EFECTO VISUAL DE PASOS DE FIRMA SAAS --- */
    .saas-step-card:hover {
        background-color: #ffffff !important; /* Cambia a fondo blanco nítido */
        border-color: #cbd5e1 !important; /* El borde se marca un poco más */
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05) !important;
    }

    /* Margen milimétrico controlado */
    .mb-2.5 {
        margin-bottom: 0.62rem !important;
    }

        /* Muestra el aviso de "Expandir Imagen" de forma fluida */
        .saas-layout-preview:hover .hover-show {
            opacity: 1 !important;
        }

        /* Opaca un poco la imagen de fondo para que resalte el texto de zoom */
        .saas-layout-preview:hover img {
            opacity: 0.8;
        }

    /* Ajustes finos de espaciado */
    .ps-2.5 {
        padding-left: 0.75rem !important;
    }


    .mt-1.5 {
        margin-top: 0.38rem !important;
    }

     </style>

    <div class="row g-4">
        <!-- COLUMNA IZQUIERDA: Detalles Completos de la Solicitud -->
        <div class="col-12 col-lg-8">
        
            <!-- Tarjeta Principal de Información General -->
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white border-bottom-0 pt-3 d-flex justify-content-between align-items-center">
                    <h4 class="fw-bold text-secondary mb-0">
                        <i class="bi bi-patch-check-fill text-success me-2"></i>
                        Número de Validación:
                        <span class="text-primary">
                            @(Model.Solicitud?.NumeroValidacion ?? "Pendiente de Asignación")
                        </span>
                    </h4>
                    <span class="badge bg-light text-dark border px-3 py-1.5 rounded-pill fw-semibold">
                        <i class="bi bi-geo-alt me-1 text-primary"></i>@(Model.Solicitud?.Area?.Nombre ?? "Sin Área")
                    </span>
                </div>

            <div class="card-body p-4">

                <!-- 1. BLOQUE DE ENCABEZADO: Identificación del Movimiento -->
                <div class="mb-4">
                    <small class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.06em; color: #94a3b8 !important;">Tipo de Movimiento</small>

                    <!-- Contenedor flex para alinear el título con un identificador discreto -->
                    <div class="d-flex align-items-center gap-2">
                        <h4 class="fw-bold m-0 tracking-tight" style="font-size: 1.2rem; color: #0f172a;">
                            @Model.Solicitud?.TipoMovimiento.ToString()
                        </h4>

                      
                    </div>
                </div>

                <div class="divider-light mb-4" style="height: 1px; background-color: #f1f5f9;"></div>

                <!-- 2. SECCIÓN DE CONTENIDO: Descripción y Justificación lado a lado -->
                <div class="row g-4">

                    <!-- Descripción Detallada -->
                    <div class="col-lg-6 col-12">
                        <div class="ps-2.5 border-start border-primary border-2 h-100 d-flex flex-column justify-content-start">
                            <small class="text-uppercase text-muted fw-bold d-block mb-1.5" style="font-size: 0.62rem; letter-spacing: 0.06em; color: #94a3b8 !important;">Descripción Detallada</small>
                            <p class="text-secondary small mb-0 font-normal" style="color: #334155 !important; line-height: 1.5; font-size: 0.88rem;">
                                @Model.Solicitud?.Descripcion
                            </p>
                        </div>
                    </div>

                    <!-- Justificación de Petición -->
                    <div class="col-lg-6 col-12">
                        <div class="ps-2.5 border-start border-light-subtle border-2 h-100 d-flex flex-column justify-content-start" style="border-color: #cbd5e1 !important;">
                            <small class="text-uppercase text-muted fw-bold d-block mb-1.5" style="font-size: 0.62rem; letter-spacing: 0.06em; color: #94a3b8 !important;">Justificación de Petición</small>
                            <p class="text-muted small mb-0 font-normal" style="color: #475569 !important; line-height: 1.5; font-size: 0.88rem;">
                                @Model.Solicitud?.Razon
                            </p>
                        </div>
                    </div>

                </div>

                <!-- 3. SECCIÓN DE ADJUNTOS: Layout / Croquis Estilo Dashboard -->
                @if (Model.Solicitud != null && !string.IsNullOrEmpty(Model.Solicitud.ImagenLayout))
                {
                    <div class="mt-4 pt-4 border-top border-light-subtle">
                        <small class="text-uppercase text-muted fw-bold d-block mb-2.5" style="font-size: 0.62rem; letter-spacing: 0.06em; color: #94a3b8 !important;">Layout / Croquis Adjunto</small>

                        <!-- Panel de previsualización interactivo con efecto hover -->
                        <div class="bg-white rounded-3 border border-light-subtle p-3 position-relative text-center saas-layout-preview"
                             style="background-color: #f8fafc !important;">

                            <a href="@Model.Solicitud.ImagenLayout" target="_blank" class="d-inline-block text-decoration-none group-hover-opacity position-relative">
                                <!-- Imagen enmarcada limpiamente -->
                                <img src="@Model.Solicitud.ImagenLayout"
                                     class="img-fluid rounded-2 shadow-sm border"
                                     style="max-height: 240px; object-fit: contain; transition: opacity 0.2s ease;"
                                     alt="Layout del Movimiento" />

                                <!-- Capa flotante discreta para indicar acción de zoom -->
                                <div class="badge bg-dark bg-opacity-75 text-white px-2.5 py-1.5 rounded-2 font-monospace position-absolute top-50 start-50 translate-middle opacity-0 hover-show"
                                     style="font-size: 0.7rem; transition: opacity 0.2s ease;">
                                    <i class="bi bi-zoom-in me-1"></i> EXPANDIR IMAGEN
                                </div>
                            </a>

                        </div>
                    </div>
                }
            </div>

            </div>

            <!-- Tarjeta Secundaria: Información Técnica (Si ya fue llenada por el Aprobador) -->
            @if (Model.Solicitud?.MovimientosTecnicos != null)
            {
                var tech = Model.Solicitud.MovimientosTecnicos;
            
                <div class="card shadow-sm border-0 rounded-3 mb-4">
                    <div class="card-header bg-white border-bottom-0 pt-3">
                        <h5 class="fw-bold text-secondary mb-0">
                            <i class="bi bi-boxes text-info me-2"></i>Revision de Movimientos
                        </h5>
                    </div>
                    <div class="card-body">
                        <!-- 1. Cuadrícula de Interruptores Técnicos (Estatus Aplica/No) -->
                        <div class="tech-switch-grid mb-4">

                            <!-- IoT / IT -->
                            <div class="tech-switch-cell shadow-xs">
                                <span class="tech-switch-title"><i class="bi bi-cpu me-2 text-muted"></i>Movimiento IT / IoT</span>
                                <span class="badge @(tech.MovimientoITIoT ? "bg-success-subtle text-success" : "bg-light text-muted border") rounded-pill px-2.5 py-1">
                                    @(tech.MovimientoITIoT ? "Aplica" : "No")
                                </span>
                            </div>

                            <!-- Programación -->
                            <div class="tech-switch-cell shadow-xs">
                                <span class="tech-switch-title"><i class="bi bi-code-slash me-2 text-muted"></i>Programación</span>
                                <span class="badge @(tech.MovimientoProgramacion ? "bg-success-subtle text-success" : "bg-light text-muted border") rounded-pill px-2.5 py-1">
                                    @(tech.MovimientoProgramacion ? "Aplica" : "No")
                                </span>
                            </div>

                            <!-- Eléctrico -->
                            <div class="tech-switch-cell shadow-xs">
                                <span class="tech-switch-title"><i class="bi bi-lightning me-2 text-muted"></i>Electrónico / Eléctrico</span>
                                <span class="badge @(tech.MovimientoElectrico ? "bg-success-subtle text-success" : "bg-light text-muted border") rounded-pill px-2.5 py-1">
                                    @(tech.MovimientoElectrico ? "Aplica" : "No")
                                </span>
                            </div>

                            <!-- EHS -->
                            <div class="tech-switch-cell shadow-xs">
                                <span class="tech-switch-title"><i class="bi bi-shield-exclamation me-2 text-muted"></i>Normativa EHS</span>
                                <span class="badge @(tech.MovimientoEHS ? "bg-success-subtle text-success" : "bg-light text-muted border") rounded-pill px-2.5 py-1">
                                    @(tech.MovimientoEHS ? "Aplica" : "No")
                                </span>
                            </div>

                            <!-- Cambio Nomenclatura -->
                            <div class="tech-switch-cell shadow-xs">
                                <span class="tech-switch-title"><i class="bi bi-tag me-2 text-muted"></i>Cambio Nomenclatura</span>
                                <span class="badge @(tech.CambioNomenclatura ? "bg-success-subtle text-success" : "bg-light text-muted border") rounded-pill px-2.5 py-1">
                                    @(tech.CambioNomenclatura ? "Aplica" : "No")
                                </span>
                            </div>

                            <!-- Requiere PCR -->
                            <div class="tech-switch-cell shadow-xs">
                                <span class="tech-switch-title"><i class="bi bi-file-earmark-check me-2 text-muted"></i>Requiere PCR</span>
                                <span class="badge @(tech.RequierePCR ? "bg-success-subtle text-success" : "bg-light text-muted border") rounded-pill px-2.5 py-1">
                                    @(tech.RequierePCR ? "Aplica" : "No")
                                </span>
                            </div>
                        </div>

                        <!-- 2. Información Adicional del PCR (Si aplica, muestra el número de folio) -->
                        @if (tech.RequierePCR && !string.IsNullOrEmpty(tech.NumeroPCR))
                        {
                            <div class="mb-4 bg-light p-3 rounded-3 border border-start border-info border-3 shadow-xs">
                                <small class="text-uppercase text-muted fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Folio de Control PCR</small>
                                <span class="fw-bold text-dark fs-6"><i class="bi bi-hash me-1 text-info"></i>@tech.NumeroPCR</span>
                            </div>
                        }

                        <!-- 3. Galería de Evidencias Visuales (Imagen Antes y Después) -->
                        @if (!string.IsNullOrEmpty(tech.ImagenAntes) || !string.IsNullOrEmpty(tech.ImagenDespues))
                        {
                            <div class="divider-dashed my-3"></div>
                            <small class="text-uppercase text-muted fw-bold d-block mb-3" style="font-size: 0.65rem; letter-spacing: 0.5px;">Cambios del movimiento</small>

                            <div class="row g-3">
                                <!-- Imagen Antes -->
                                <div class="col-12 col-sm-6">
                                    <div class="card h-100 bg-light border border-light p-2 rounded-3 text-center">
                                        <span class="text-uppercase text-secondary fw-bold d-block mb-2" style="font-size: 0.6rem;">Estado Inicial (Antes)</span>
                                        @if (!string.IsNullOrEmpty(tech.ImagenAntes))
                                        {
                                            <a href="@tech.ImagenAntes" target="_blank" title="Ver imagen original">
                                                <img src="@tech.ImagenAntes" class="img-fluid rounded-2 shadow-xs" style="max-height: 160px; object-fit: cover;" alt="Antes" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="py-4 text-muted small italic"><i class="bi bi-image text-muted opacity-50 d-block mb-1 fs-4"></i>Sin evidencia inicial</div>
                                        }
                                    </div>
                                </div>

                                <!-- Imagen Después -->
                                <div class="col-12 col-sm-6">
                                    <div class="card h-100 bg-light border border-light p-2 rounded-3 text-center">
                                        <span class="text-uppercase text-secondary fw-bold d-block mb-2" style="font-size: 0.6rem;">Estado Final (Después)</span>
                                        @if (!string.IsNullOrEmpty(tech.ImagenDespues))
                                        {
                                            <a href="@tech.ImagenDespues" target="_blank" title="Ver imagen original">
                                                <img src="@tech.ImagenDespues" class="img-fluid rounded-2 shadow-xs" style="max-height: 160px; object-fit: cover;" alt="Después" />
                                            </a>
                                        }
                                        else
                                        {
                                            <div class="py-4 text-muted small italic"><i class="bi bi-image text-muted opacity-50 d-block mb-1 fs-4"></i>Sin evidencia final</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </div>



            }

            @if (ViewBag.Firmas != null)
            {
            <div class="card border border-light-subtle rounded-3 bg-white shadow-sm mb-4">

                <!-- Encabezado de la Tarjeta -->
                <div class="card-header bg-transparent border-0 pt-3 pb-2 px-4">
                    <h5 class="fw-bold text-dark m-0 tracking-tight" style="font-size: 1.05rem; color: #0f172a;">
                        <i class="bi bi-vector-pen text-primary me-2 opacity-80"></i>Flujo de Autorización y Firmas
                    </h5>
                </div>

                <!-- Cuerpo de la Tarjeta con Grid Modular de Firmas -->
                <div class="card-body px-4 pb-4 pt-2">
                    <!-- row g-3 se encarga de empaquetar de 3 en 3 en pantallas grandes -->
                    <div class="row g-3 align-items-stretch">

                        @foreach (var firma in (IEnumerable<SolicitudFirma>)ViewBag.Firmas)
                        {
                            <!-- 3 por fila en PC de escritorio (col-xl-4), 2 por fila en tablet (col-md-6) -->
                            <div class="col-xl-4 col-md-6 d-flex">
                                <div class="card w-100 border border-light-subtle rounded-3 p-3 position-relative saas-step-card"
                                     style="background-color: #f8fafc; transition: all 0.2s ease;">

                                    <!-- Barra Superior del Módulo: Tipo de Firma + Icono de Estado -->
                                    <div class="d-flex justify-content-between align-items-start mb-2.5">
                                        <h6 class="fw-bold text-dark m-0 pe-2 text-truncate" style="font-size: 0.92rem; color: #1e293b;" title="@firma.TipoFirma?.Nombre">
                                            @firma.TipoFirma?.Nombre
                                        </h6>

                                        <!-- Icono Indicador Redondeado Minimalista -->
                                        <span class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0 shadow-sm"
                                              style="width: 24px; height: 24px; background-color: #ffffff; border: 2px solid @(firma.Firmada ? "#22c55e" : "#fbbf24");">
                                            @if (firma.Firmada)
                                            {
                                                <i class="bi bi-check text-success fw-bold" style="font-size: 0.9rem;"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-clock text-warning" style="font-size: 0.75rem;"></i>
                                            }
                                        </span>
                                    </div>

                                    <!-- Información del Usuario Asignado -->
                                    <div class="mb-2 ps-1">
                                        <span class="text-secondary small d-flex align-items-center gap-1.5 text-truncate" style="color: #475569 !important; font-size: 0.82rem;">
                                            <i class="bi bi-person text-muted" style="font-size: 0.9rem;"></i>
                                            @(firma.Firmada? firma.UsuarioFirmante?.NombreCompleto : firma.UsuarioRequerido?.NombreCompleto)
                                        </span>
                                    </div>

                                    <!-- Espacio final reservado para el Estatus e Historial de Tiempo -->
                                    <div class="mt-auto pt-2 border-top border-white d-flex justify-content-between align-items-center">
                                        @if (firma.Firmada)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-2 py-0.5 rounded font-monospace" style="font-size: 0.65rem; font-weight: 600;">
                                                FIRMED
                                            </span>
                                            <small class="text-muted font-monospace" style="font-size: 0.7rem; color: #94a3b8 !important;">
                                                <i class="bi bi-calendar3 me-1"></i>@firma.FechaFirma?.ToString("dd/MM/yyyy HH:mm")
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning border border-warning-subtle px-2 py-0.5 rounded font-monospace" style="font-size: 0.65rem; font-weight: 600;">
                                                PENDING
                                            </span>
                                            <small class="text-muted font-monospace italic" style="font-size: 0.7rem; color: #94a3b8 !important;">
                                                En espera...
                                            </small>
                                        }
                                    </div>

                                </div>
                            </div>
                        }

                    </div>
                </div>

            </div>


            }


        </div>



        <!-- COLUMNA DERECHA: Firma Digital del Usuario -->
        <div class="col-12 col-lg-4">
            <div class="card shadow-sm border-0 rounded-3 position-sticky" style="top: 20px;">
                <div class="card-header bg-white border-bottom-0 pt-3">
                    <h5 class="fw-bold text-secondary mb-0">
                        <i class="bi bi-fingerprint text-success me-2"></i>Firma de Enterado
                    </h5>
                </div>
            
                <div class="card-body">
                    <p class="text-muted small">
                        Estás por validar este movimiento como: 
                        <strong class="text-dark">@(Model.TipoFirma?.Nombre ?? "Validación General")</strong>.
                    </p>

                    <!-- Vista de la Firma Previamente Cargada del Sistema -->
                    <div class="signature-preview-box mb-4 shadow-xs">
                        <div class="text-uppercase text-muted fw-bold mb-2" style="font-size: 0.65rem; letter-spacing: 1px;">Firma Digital</div>
                    
                        <!-- Iconografía simuladora de firma en el backend -->
                        <i class="bi bi-shield-lock-fill fs-2 text-success d-block mb-1"></i>
                        <span class="font-monospace text-dark d-block fw-bold small text-truncate">@User.Identity?.Name</span>
                        <small class="text-muted italic" style="font-size: 0.75rem;">Token de seguridad generado en sesión</small>
                    </div>

                    <!-- Formulario de Acción para Guardar/Firmar -->
                    @if (!Model.Firmada)
                    {
                        <!-- FORMULARIO DE ACCIÓN PARA GUARDAR/FIRMAR DIGITALMENTE -->
                        <form asp-action="FirmarSolicitud" method="post">

                            <!-- Genera el token de seguridad obligatorio para solicitudes POST de ASP.NET Core -->
                            @Html.AntiForgeryToken()

                            <!-- Enviamos el ID de la SolicitudFirma oculto -->
                            <input type="hidden" name="id" value="@Model.Id" />

                            <!-- Validación opcional mediante Checkbox antes de liberar el botón -->
                            <div class="form-check mb-4 text-start">
                                <input class="form-check-input" type="checkbox" id="chkAcepto" required />
                                <label class="form-check-label text-secondary small fw-medium" for="chkAcepto">
                                    Confirmo que revisé la descripción, justificación y el layout adjunto de este movimiento.
                                </label>
                            </div>

                            <!-- Botonera Interactiva -->
                            <div class="d-grid gap-2">
                                <button type="submit" class="btn btn-success rounded-pill fw-semibold py-2 shadow-sm">
                                    <i class="bi bi-pen me-1.5"></i>Aceptar
                                </button>

                                <a asp-action="Pendientes" class="btn btn-outline-secondary rounded-pill fw-semibold py-2">
                                    Regresar a la Lista
                                </a>
                            </div>

                        </form>
                    }
                    else
                    {
                        <!-- PANEL PREMIUM: REGISTRO EXITOSO HISTÓRICO -->
                        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 p-3 bg-success-subtle text-success">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-check-circle-fill fs-3 me-3"></i>
                                <div>
                                    <div class="fw-bold fs-6">Firma registrada correctamente</div>
                                    <small class="text-secondary d-block mt-0.5">
                                        Esta solicitud fue firmada por ti el:
                                        <strong class="text-dark">
                                            @Model.FechaFirma?.ToString("dd/MM/yyyy HH:mm")
                                        </strong>
                                    </small>
                                </div>
                            </div>
                        </div>

                        <!-- Botonera de Escape para registros ya firmados -->
                        <div class="d-grid">
                            <a asp-action="Pendientes" class="btn btn-outline-secondary rounded-pill fw-semibold py-2">
                                Regresar a Mis Firmas
                            </a>
                        </div>
                    }
                </div>
            </div>  
        </div>
    </div>